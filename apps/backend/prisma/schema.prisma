generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMERACIONES
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  CASHIER
  WAREHOUSE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum UnitOfMeasure {
  UNIT
  KG
  GRAM
  LITER
  ML
  PACK
  BOX
  DOZEN
  METER
}

enum MovementType {
  PURCHASE_IN
  PURCHASE_VOID
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_STOCK
  LOSS
  EXPIRY
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  CREDIT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  CREDIT
  YAPE
  PLIN
  OTHER
}

enum DocumentType {
  BOLETA
  FACTURA
  NOTA_VENTA
  TICKET
}

enum CustomerType {
  REGULAR
  WHOLESALE
  VIP
  CREDIT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum ExpenseCategory {
  PERSONNEL
  BAGS
  TRANSPORT
  SYSTEM
  WATER
  ELECTRICITY
  RENT
  OTHER
}

enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  BUY_X_GET_Y
  BUNDLE_PRICE
  HAPPY_HOUR
  // Combo de varios productos DISTINTOS a un precio total fijo (ej. pan +
  // huevo + leche = S/4.30) — a diferencia de BUNDLE_PRICE, que es N
  // unidades del MISMO producto. Usa PromotionProduct.quantity por cada
  // producto del combo; "value" en Promotion es el precio total del combo.
  COMBO
}

// Solo aplica a HAPPY_HOUR — los demás tipos ya implican su propia semántica
// de valor (PERCENTAGE_DISCOUNT siempre %, FIXED_DISCOUNT siempre S/).
enum PromotionValueType {
  PERCENTAGE
  FIXED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PRINT
  APPROVE
  REJECT
  VOID
}

// =============================================================================
// USUARIOS Y SEGURIDAD
// =============================================================================

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  username            String     @unique
  passwordHash        String     @map("password_hash")
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  phone               String?
  pin                 String? // 4-digit PIN hash para cambio rápido de turno
  role                UserRole   @default(CASHIER)
  status              UserStatus @default(ACTIVE)
  mustChangePassword  Boolean    @default(true) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedAt            DateTime?  @map("locked_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  lastLoginIp         String?    @map("last_login_ip")
  avatarUrl           String?    @map("avatar_url")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  sessions                  UserSession[]
  cashSessions              CashSession[]
  salesAsCashier            Sale[]                     @relation("CashierSales")
  salesAsCreated            Sale[]                     @relation("CreatedBySales")
  inventoryAdjustments      InventoryAdjustment[]
  purchaseOrders            PurchaseOrder[]
  auditLogs                 AuditLog[]
  approvedPurchases         PurchaseOrder[]            @relation("ApprovedByPurchases")
  voidedPurchases           PurchaseOrder[]            @relation("VoidedByPurchases")
  voidedSales               Sale[]                     @relation("VoidedBySales")
  treasuryMovements         TreasuryMovement[]
  expenses                  Expense[]
  recurringExpenseTemplates RecurringExpenseTemplate[]
  supplierPayments          SupplierPayment[]
  supplierPaymentBatches    SupplierPaymentBatch[]
  payerRepayments           PayerRepayment[]
  payerRepaymentBatches     PayerRepaymentBatch[]
  bottleDepositMovements    BottleDepositMovement[]
  payerMovements            PayerMovement[]
  treasuryReconciliations   TreasuryReconciliation[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String // tabla/entidad afectada
  resourceId String?     @map("resource_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// =============================================================================
// CONFIGURACIÓN DEL SISTEMA
// =============================================================================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  group     String   @default("general")
  label     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model DocumentSeries {
  id            String       @id @default(uuid())
  type          DocumentType
  series        String // "B001", "F001"
  currentNumber Int          @default(0) @map("current_number")
  prefix        String       @default("")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  sales Sale[]

  @@unique([type, series])
  @@map("document_series")
}

model TaxRate {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // IGV, EXONERADO, etc.
  rate      Decimal  @db.Decimal(5, 4)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("tax_rates")
}

// =============================================================================
// CATEGORÍAS Y MARCAS
// =============================================================================

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("brands")
}

// =============================================================================
// PROVEEDORES
// =============================================================================

model Supplier {
  id              String    @id @default(uuid())
  businessName    String    @map("business_name")
  taxId           String?   @unique @map("tax_id") // RUC
  contactName     String?   @map("contact_name")
  email           String?
  phone           String?
  address         String?
  city            String?
  paymentTermDays Int       @default(30) @map("payment_term_days")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  products         Product[]
  purchaseOrders   PurchaseOrder[]
  supplierProducts SupplierProduct[]
  paymentBatches   SupplierPaymentBatch[]

  @@index([taxId])
  @@index([businessName])
  @@map("suppliers")
}

// Persona o tercero que puso el dinero de su bolsillo para pagar una compra
// (ej. el dueño compra en un mercado y paga en efectivo antes de que la
// mercadería llegue al sistema) — distinto del Supplier, que es quien vendió
// la mercadería. Cuando una PurchaseOrder tiene payerId, el proveedor ya
// quedó pagado (no genera cuenta por pagar a proveedor) pero se abre una
// deuda de la empresa hacia este pagador, que se repone por separado.
model Payer {
  id     String @id @default(uuid())
  name   String
  phone  String?
  notes  String?
  // Aviso (no bloqueo duro) cuando la deuda hacia este pagador supera este
  // monto. 0 = sin límite.
  creditLimit Decimal   @default(0) @map("credit_limit") @db.Decimal(12, 2)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  purchaseOrders   PurchaseOrder[]
  repayments       PayerRepayment[]
  repaymentBatches PayerRepaymentBatch[]
  movements        PayerMovement[]

  @@index([name])
  @@map("payers")
}

enum PayerMovementType {
  CARGO
  ABONO
}

// Kardex de deuda hacia un Pagador — mismo patrón que TreasuryMovement:
// CARGO cuando financia una compra (sube lo que le debemos), ABONO cuando se
// le repone dinero (baja lo que le debemos). balanceAfter del movimiento más
// reciente = saldo actual, sin campo de saldo mutable que se pueda
// desincronizar.
model PayerMovement {
  id            String            @id @default(uuid())
  payerId       String            @map("payer_id")
  type          PayerMovementType
  amount        Decimal           @db.Decimal(12, 2)
  balanceBefore Decimal           @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(12, 2)
  referenceType String?           @map("reference_type") // PURCHASE | PAYER_REPAYMENT_BATCH | PURCHASE_VOID
  referenceId   String?           @map("reference_id")
  description   String
  userId        String            @map("user_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  payer Payer @relation(fields: [payerId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([payerId])
  @@index([referenceType, referenceId])
  @@map("payer_movements")
}

// Catálogo real de qué producto vende cada proveedor y a qué precio.
// Se alimenta solo (al crear/recibir órdenes de compra) y también se
// puede registrar a mano, para poder armar pedidos sugeridos y comparar
// precios entre proveedores sin depender del Product.supplierId único.
model SupplierProduct {
  id             String    @id @default(uuid())
  supplierId     String    @map("supplier_id")
  productId      String    @map("product_id")
  price          Decimal   @db.Decimal(10, 2)
  supplierSku    String?   @map("supplier_sku")
  isPreferred    Boolean   @default(false) @map("is_preferred")
  lastPurchaseAt DateTime? @map("last_purchase_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

// =============================================================================
// PRODUCTOS E INVENTARIO
// =============================================================================

model Product {
  id             String        @id @default(uuid())
  name           String
  description    String?
  barcode        String?       @unique
  internalCode   String?       @unique @map("internal_code")
  sku            String?       @unique
  categoryId     String        @map("category_id")
  brandId        String?       @map("brand_id")
  supplierId     String?       @map("supplier_id")
  taxRateId      String?       @map("tax_rate_id")
  unitOfMeasure  UnitOfMeasure @default(UNIT) @map("unit_of_measure")
  costPrice      Decimal       @map("cost_price") @db.Decimal(10, 4)
  salePrice      Decimal       @map("sale_price") @db.Decimal(10, 2)
  wholesalePrice Decimal?      @map("wholesale_price") @db.Decimal(10, 2)
  minStock       Decimal       @default(0) @map("min_stock") @db.Decimal(10, 3)
  maxStock       Decimal?      @map("max_stock") @db.Decimal(10, 3)
  currentStock   Decimal       @default(0) @map("current_stock") @db.Decimal(10, 3)
  reservedStock  Decimal       @default(0) @map("reserved_stock") @db.Decimal(10, 3)
  isComposite    Boolean       @default(false) @map("is_composite")
  hasVariants    Boolean       @default(false) @map("has_variants")
  imageUrl       String?       @map("image_url")
  status         ProductStatus @default(ACTIVE)
  trackExpiry    Boolean       @default(false) @map("track_expiry")
  trackBatch     Boolean       @default(false) @map("track_batch")
  isBulk         Boolean       @default(false) @map("is_bulk")
  bulkUnit       String?       @map("bulk_unit") // "kg", "g", "L", "unidad"
  // Acceso rápido en el POS para productos sin código de barras (a granel u
  // otros que no vienen con empaque) — el cajero los encuentra con un toque
  // en vez de tener que buscarlos por nombre.
  isFavorite     Boolean       @default(false) @map("is_favorite")
  // Garantía por envase retornable (ej. S/1 por botella) — 0 significa que
  // este producto no maneja envase con garantía. Independiente de la venta:
  // se cobra/devuelve por su cuenta, nunca como parte del ticket de venta.
  bottleDeposit  Decimal       @default(0) @map("bottle_deposit") @db.Decimal(10, 2)
  // Orden de la tienda online: por defecto se agrupa por familia (sizeGroup)
  // y se ordena por tamaño ascendente (sizeValue, en ml o g) dentro de cada
  // familia — ambos derivados del nombre en products.service.ts al crear o
  // editar. storeFeatured es la única palanca manual: sube el producto al
  // principio de su categoría en la tienda, sin tocar el resto del orden.
  storeFeatured  Boolean       @default(false) @map("store_featured")
  sizeGroup      String?       @map("size_group")
  sizeValue      Float?        @map("size_value")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  category               Category                @relation(fields: [categoryId], references: [id])
  brand                  Brand?                  @relation(fields: [brandId], references: [id])
  supplier               Supplier?               @relation(fields: [supplierId], references: [id])
  taxRate                TaxRate?                @relation(fields: [taxRateId], references: [id])
  variants               ProductVariant[]
  compositeItems         CompositeProduct[]      @relation("ParentProduct")
  usedInComposites       CompositeProduct[]      @relation("ComponentProduct")
  inventoryMovements     InventoryMovement[]
  saleItems              SaleItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  stockAlerts            StockAlert[]
  batches                Batch[]
  promotionItems         PromotionProduct[]
  supplierProducts       SupplierProduct[]
  bottleDepositMovements BottleDepositMovement[]

  @@index([barcode])
  @@index([internalCode])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([isFavorite])
  @@index([sizeGroup])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  name         String // "500ml", "Rojo", "XL"
  variantType  String   @map("variant_type") // "tamaño", "sabor", "color"
  barcode      String?  @unique
  salePrice    Decimal? @map("sale_price") @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  currentStock Int      @default(0) @map("current_stock")
  imageUrl     String?  @map("image_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model CompositeProduct {
  id          String  @id @default(uuid())
  parentId    String  @map("parent_id")
  componentId String  @map("component_id")
  quantity    Decimal @db.Decimal(10, 3)

  parent    Product @relation("ParentProduct", fields: [parentId], references: [id])
  component Product @relation("ComponentProduct", fields: [componentId], references: [id])

  @@unique([parentId, componentId])
  @@map("composite_products")
}

model Batch {
  id                String    @id @default(uuid())
  productId         String    @map("product_id")
  batchNumber       String    @map("batch_number")
  quantity          Int
  expiryDate        DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")
  locationZone      String?   @map("location_zone")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([expiryDate])
  @@index([batchNumber])
  @@map("batches")
}

model InventoryMovement {
  id             String       @id @default(uuid())
  productId      String       @map("product_id")
  type           MovementType
  quantity       Decimal      @db.Decimal(10, 3) // positivo = entrada, negativo = salida
  quantityBefore Decimal      @map("quantity_before") @db.Decimal(10, 3)
  quantityAfter  Decimal      @map("quantity_after") @db.Decimal(10, 3)
  unitCost       Decimal?     @map("unit_cost") @db.Decimal(10, 4)
  // Costo promedio ponderado del producto antes/después de este movimiento —
  // solo se llena en movimientos que recalculan CPP (compras y su reversión).
  // Es el kardex de costos: permite ver cómo evolucionó el costo y revertir
  // una compra anulada con exactitud, sin depender de otros movimientos.
  avgCostBefore  Decimal?     @map("avg_cost_before") @db.Decimal(10, 4)
  avgCostAfter   Decimal?     @map("avg_cost_after") @db.Decimal(10, 4)
  referenceType  String?      @map("reference_type") // "SALE", "PURCHASE", "ADJUSTMENT"
  referenceId    String?      @map("reference_id")
  notes          String?
  userId         String?      @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model InventoryAdjustment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  reason    String
  notes     String?
  status    String   @default("APPLIED")
  createdAt DateTime @default(now()) @map("created_at")

  user  User                      @relation(fields: [userId], references: [id])
  items InventoryAdjustmentItem[]

  @@index([userId])
  @@index([createdAt])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id               String  @id @default(uuid())
  adjustmentId     String  @map("adjustment_id")
  productId        String  @map("product_id")
  systemQuantity   Decimal @map("system_quantity") @db.Decimal(10, 3)
  physicalQuantity Decimal @map("physical_quantity") @db.Decimal(10, 3)
  difference       Decimal @db.Decimal(10, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(10, 4)

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id])

  @@index([adjustmentId])
  @@map("inventory_adjustment_items")
}

model StockAlert {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  alertType  String    @map("alert_type") // LOW_STOCK, OUT_OF_STOCK, EXPIRY_NEAR
  threshold  Int?
  isActive   Boolean   @default(true) @map("is_active")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([isActive])
  @@map("stock_alerts")
}

// =============================================================================
// COMPRAS
// =============================================================================

model PurchaseOrder {
  id                    String                @id @default(uuid())
  orderNumber           String                @unique @map("order_number")
  supplierId            String                @map("supplier_id")
  userId                String                @map("user_id")
  approvedById          String?               @map("approved_by_id")
  status                PurchaseOrderStatus   @default(DRAFT)
  // Cuánto de esta compra ya salió de Caja General vs. cuánto queda como
  // deuda con el proveedor (cuenta por pagar). PAID/PARTIAL/CREDIT se derivan
  // de paidAmount vs. totalAmount cada vez que se registra un pago.
  paymentStatus         PurchasePaymentStatus @default(CREDIT) @map("payment_status")
  paidAmount            Decimal               @default(0) @map("paid_amount") @db.Decimal(12, 2)
  // Si esta compra la pagó un tercero de su bolsillo (no la empresa), va acá
  // en vez de generar cuenta por pagar al proveedor — ver comentario en el
  // modelo Payer. payerReimbursedAmount lleva cuánto de eso ya se le repuso.
  payerId               String?               @map("payer_id")
  payerReimbursedAmount Decimal               @default(0) @map("payer_reimbursed_amount") @db.Decimal(12, 2)
  // Cuánto de totalAmount puso el pagador (puede ser menos que totalAmount:
  // el resto se paga al contado vía `payments`/legs o queda a crédito con el
  // proveedor). paidAmount sigue siendo "cuánto quedó saldado con el
  // proveedor" venga de donde venga (contado + payerAmount).
  payerAmount           Decimal               @default(0) @map("payer_amount") @db.Decimal(12, 2)
  // Fecha límite para pagar al proveedor (createdAt/receivedDate +
  // supplier.paymentTermDays al crear la compra). Editable a mano después.
  dueDate               DateTime?             @map("due_date")
  // OBSERVADO: discrepancia entre lo pedido y lo recibido (o marcada a mano)
  // que excluye esta OC de los pagos "por monto" (FIFO) hasta resolverse —
  // no bloquea pagos manuales ni la recepción.
  hasDiscrepancy        Boolean               @default(false) @map("has_discrepancy")
  discrepancyNotes      String?               @map("discrepancy_notes")
  expectedDate          DateTime?             @map("expected_date")
  receivedDate          DateTime?             @map("received_date")
  subtotal              Decimal               @db.Decimal(12, 2)
  taxAmount             Decimal               @map("tax_amount") @db.Decimal(12, 2)
  totalAmount           Decimal               @map("total_amount") @db.Decimal(12, 2)
  notes                 String?
  supplierInvoice       String?               @map("supplier_invoice")
  voidedAt              DateTime?             @map("voided_at")
  voidedById            String?               @map("voided_by_id")
  voidReason            String?               @map("void_reason")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  payer           Payer?              @relation(fields: [payerId], references: [id])
  user            User                @relation(fields: [userId], references: [id])
  approvedBy      User?               @relation("ApprovedByPurchases", fields: [approvedById], references: [id])
  voidedBy        User?               @relation("VoidedByPurchases", fields: [voidedById], references: [id])
  items           PurchaseOrderItem[]
  receipts        PurchaseReceipt[]
  payments        SupplierPayment[]
  payerRepayments PayerRepayment[]

  @@index([supplierId])
  @@index([payerId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  orderedQty      Decimal @map("ordered_qty") @db.Decimal(10, 3)
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(10, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(10, 4)
  taxRate         Decimal @default(0.18) @map("tax_rate") @db.Decimal(5, 4)
  subtotal        Decimal @db.Decimal(12, 2)
  // Línea de bonificación del proveedor (producto gratis) — el costo se
  // fuerza a 0 en el backend sin importar lo que llegue aquí.
  isBonus         Boolean @default(false) @map("is_bonus")
  notes           String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id          String    @id @default(uuid())
  receiptId   String    @map("receipt_id")
  productId   String    @map("product_id")
  orderedQty  Decimal   @map("ordered_qty") @db.Decimal(10, 3)
  receivedQty Decimal   @map("received_qty") @db.Decimal(10, 3)
  unitCost    Decimal   @map("unit_cost") @db.Decimal(10, 4)
  isBonus     Boolean   @default(false) @map("is_bonus")
  batchNumber String?   @map("batch_number")
  expiryDate  DateTime? @map("expiry_date")
  notes       String?

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id])

  @@index([receiptId])
  @@map("purchase_receipt_items")
}

model SupplierPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  userId          String        @map("user_id")
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  reference       String?
  paidAt          DateTime      @default(now()) @map("paid_at")
  notes           String?
  // Cuando un solo pago "por monto" se reparte entre varias OC del mismo
  // proveedor (amortización FIFO), todas las filas resultantes comparten
  // este batchId — así se puede mostrar como un solo evento de pago aunque
  // cada fila siga apuntando a UNA orden (mismo esquema de siempre, nada se
  // rompe para pagos de una sola orden donde batchId queda null).
  batchId         String?       @map("batch_id")

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  batch         SupplierPaymentBatch? @relation(fields: [batchId], references: [id])

  @@index([purchaseOrderId])
  @@index([batchId])
  @@map("supplier_payments")
}

// Encabezado de un pago "por monto" a un proveedor que la lógica de
// amortización reparte entre sus compras pendientes más antiguas — agrupa
// las filas de SupplierPayment que genera para poder mostrarlas/anularlas
// juntas sin perder la trazabilidad por orden.
model SupplierPaymentBatch {
  id          String   @id @default(uuid())
  supplierId  String   @map("supplier_id")
  userId      String   @map("user_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  reference   String?
  notes       String?
  paidAt      DateTime @default(now()) @map("paid_at")

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  payments SupplierPayment[]

  @@index([supplierId])
  @@map("supplier_payment_batches")
}

// Reposición de dinero a un Payer (tercero que pagó una compra de su
// bolsillo) — mismo patrón que SupplierPayment/SupplierPaymentBatch: cada
// fila queda ligada a UNA orden (para saber qué compra terminó de reponerse)
// y varias filas pueden compartir un batchId cuando un pago por monto se
// reparte entre varias compras pendientes del mismo pagador.
model PayerRepayment {
  id              String        @id @default(uuid())
  payerId         String        @map("payer_id")
  purchaseOrderId String        @map("purchase_order_id")
  batchId         String?       @map("batch_id")
  userId          String        @map("user_id")
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  reference       String?
  notes           String?
  paidAt          DateTime      @default(now()) @map("paid_at")

  payer         Payer                @relation(fields: [payerId], references: [id])
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  batch         PayerRepaymentBatch? @relation(fields: [batchId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])

  @@index([payerId])
  @@index([purchaseOrderId])
  @@index([batchId])
  @@map("payer_repayments")
}

model PayerRepaymentBatch {
  id          String   @id @default(uuid())
  payerId     String   @map("payer_id")
  userId      String   @map("user_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  reference   String?
  notes       String?
  paidAt      DateTime @default(now()) @map("paid_at")

  payer    Payer            @relation(fields: [payerId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  payments PayerRepayment[]

  @@index([payerId])
  @@map("payer_repayment_batches")
}

// =============================================================================
// CLIENTES
// =============================================================================

model Customer {
  id             String       @id @default(uuid())
  taxId          String?      @unique @map("tax_id") // DNI o RUC
  taxIdType      String?      @map("tax_id_type") // DNI, RUC, CE
  firstName      String       @map("first_name")
  lastName       String?      @map("last_name")
  businessName   String?      @map("business_name")
  email          String?
  phone          String?
  address        String?
  district       String?
  city           String?
  type           CustomerType @default(REGULAR)
  creditLimit    Decimal      @default(0) @map("credit_limit") @db.Decimal(10, 2)
  currentBalance Decimal      @default(0) @map("current_balance") @db.Decimal(10, 2)
  loyaltyPoints  Int          @default(0) @map("loyalty_points")
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  sales         Sale[]
  debtPayments  CustomerDebtPayment[]
  coupons       Coupon[]
  storeAccounts StoreCustomer[]

  @@index([taxId])
  @@index([phone])
  @@index([type])
  @@map("customers")
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

// Cupón de descuento % generado automáticamente cuando una venta supera un
// monto configurable (settings: coupon_min_sale_amount / coupon_discount_percent
// / coupon_validity_days). Se imprime en el ticket y solo lo puede canjear el
// mismo cliente en una compra futura.
model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  discountPercent Decimal      @map("discount_percent") @db.Decimal(5, 2)
  customerId      String       @map("customer_id")
  sourceSaleId    String       @unique @map("source_sale_id")
  redeemedSaleId  String?      @unique @map("redeemed_sale_id")
  status          CouponStatus @default(ACTIVE)
  expiresAt       DateTime     @map("expires_at")
  redeemedAt      DateTime?    @map("redeemed_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  customer     Customer @relation(fields: [customerId], references: [id])
  sourceSale   Sale     @relation("CouponSourceSale", fields: [sourceSaleId], references: [id])
  redeemedSale Sale?    @relation("CouponRedeemedSale", fields: [redeemedSaleId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("coupons")
}

// =============================================================================
// PUNTO DE VENTA — CAJA
// =============================================================================

model CashRegister {
  id          String   @id @default(uuid())
  name        String   @unique // "Caja 1", "Caja Principal"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  sessions CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             String            @id @default(uuid())
  cashRegisterId String            @map("cash_register_id")
  userId         String            @map("user_id")
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @map("opening_amount") @db.Decimal(10, 2)
  closingAmount  Decimal?          @map("closing_amount") @db.Decimal(10, 2)
  expectedAmount Decimal?          @map("expected_amount") @db.Decimal(10, 2)
  difference     Decimal?          @db.Decimal(10, 2)
  openedAt       DateTime          @default(now()) @map("opened_at")
  closedAt       DateTime?         @map("closed_at")
  notes          String?

  cashRegister           CashRegister                @relation(fields: [cashRegisterId], references: [id])
  user                   User                        @relation(fields: [userId], references: [id])
  sales                  Sale[]
  movements              CashMovement[]
  // Cuadre de billeteras digitales (Yape, Plin) al cerrar caja — separado del
  // efectivo porque cada método es su propia "cuenta" en Caja General.
  reconciliations        CashSessionReconciliation[]
  bottleDepositMovements BottleDepositMovement[]

  @@index([cashRegisterId])
  @@index([userId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

enum BottleDepositType {
  CHARGED
  RETURNED
}

// Garantía de envase retornable: dinero que el cliente deja en prenda por la
// botella y que se le devuelve cuando la trae de vuelta. NO es parte de la
// venta (no es ingreso ni afecta stock/margen) — es un pasivo aparte que se
// cobra y se devuelve por su cuenta, con su propio rastro en Caja General.
model BottleDepositMovement {
  id            String            @id @default(uuid())
  productId     String            @map("product_id")
  type          BottleDepositType
  quantity      Int
  amount        Decimal           @db.Decimal(10, 2)
  method        PaymentMethod
  cashSessionId String?           @map("cash_session_id")
  userId        String            @map("user_id")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  product     Product      @relation(fields: [productId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([cashSessionId])
  @@map("bottle_deposit_movements")
}

model CashSessionReconciliation {
  id             String        @id @default(uuid())
  cashSessionId  String        @map("cash_session_id")
  method         PaymentMethod
  expectedAmount Decimal       @map("expected_amount") @db.Decimal(10, 2)
  countedAmount  Decimal       @map("counted_amount") @db.Decimal(10, 2)
  difference     Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])

  @@unique([cashSessionId, method])
  @@map("cash_session_reconciliations")
}

model CashMovement {
  id            String   @id @default(uuid())
  cashSessionId String   @map("cash_session_id")
  type          String // WITHDRAWAL, DEPOSIT
  amount        Decimal  @db.Decimal(10, 2)
  reason        String
  notes         String?
  // Permite rastrear de dónde vino este movimiento (ej. "PURCHASE" + orderId)
  // para poder revertirlo con exactitud si esa operación se anula después.
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  createdAt     DateTime @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])

  @@index([cashSessionId])
  @@map("cash_movements")
}

// =============================================================================
// CAJA GENERAL (fondo del negocio, separado de las cajas del POS)
// =============================================================================

enum TreasuryMovementType {
  DEPOSIT
  WITHDRAWAL
}

// Cada "cuenta" es un fondo separado dentro de Caja General — el efectivo
// físico y el saldo de cada billetera digital nunca se mezclan, aunque las
// tres sumen al total del negocio.
enum TreasuryAccount {
  CASH
  YAPE
  PLIN
}

model TreasuryMovement {
  id            String               @id @default(uuid())
  type          TreasuryMovementType
  account       TreasuryAccount      @default(CASH)
  amount        Decimal              @db.Decimal(10, 2) // siempre positivo; el signo lo da el type
  // Kardex del saldo general — mismo patrón que InventoryMovement, así el
  // saldo actual es simplemente el balanceAfter del movimiento más reciente,
  // sin necesidad de una columna de saldo mutable que se pueda desincronizar.
  // El balance es independiente POR CUENTA (cada una tiene su propio kardex).
  balanceBefore Decimal              @map("balance_before") @db.Decimal(10, 2)
  balanceAfter  Decimal              @map("balance_after") @db.Decimal(10, 2)
  referenceType String?              @map("reference_type") // "MANUAL", "CASH_SESSION_OPEN", "CASH_SESSION_CLOSE", "EXPENSE"
  referenceId   String?              @map("reference_id")
  description   String
  userId        String               @map("user_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([account])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("treasury_movements")
}

// Conciliación de Caja General al cierre del día — mismo criterio que
// CashSessionReconciliation pero a nivel de Caja General (no de turno POS):
// compara el saldo que dice el sistema (último TreasuryMovement de esa
// cuenta) contra el conteo físico, y si hay diferencia genera un
// TreasuryMovement de ajuste para que el sistema quede igual al conteo.
model TreasuryReconciliation {
  id             String          @id @default(uuid())
  account        TreasuryAccount
  date           DateTime        @db.Date
  expectedAmount Decimal         @map("expected_amount") @db.Decimal(10, 2)
  countedAmount  Decimal         @map("counted_amount") @db.Decimal(10, 2)
  difference     Decimal         @db.Decimal(10, 2)
  notes          String?
  userId         String          @map("user_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([account, date])
  @@map("treasury_reconciliations")
}

model RecurringExpenseTemplate {
  id                  String          @id @default(uuid())
  category            ExpenseCategory
  description         String
  amount              Decimal         @db.Decimal(10, 2)
  dayOfMonth          Int             @map("day_of_month") // 1-28: día del mes en que se genera solo
  isActive            Boolean         @default(true) @map("is_active")
  lastGeneratedPeriod String?         @map("last_generated_period") // "2026-07" — evita duplicar en el mismo mes
  userId              String          @map("user_id")
  createdAt           DateTime        @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  expenses Expense[]

  @@map("recurring_expense_templates")
}

// =============================================================================
// VENTAS
// =============================================================================

model Sale {
  id               String       @id @default(uuid())
  saleNumber       String       @unique @map("sale_number")
  cashSessionId    String?      @map("cash_session_id")
  cashierId        String       @map("cashier_id")
  createdById      String       @map("created_by_id")
  customerId       String?      @map("customer_id")
  documentSeriesId String?      @map("document_series_id")
  documentNumber   String?      @map("document_number")
  documentType     DocumentType @default(TICKET) @map("document_type")
  status           SaleStatus   @default(COMPLETED)
  subtotal         Decimal      @db.Decimal(12, 2)
  discountAmount   Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountPercent  Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxAmount        Decimal      @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal      @map("total_amount") @db.Decimal(12, 2)
  amountTendered   Decimal?     @map("amount_tendered") @db.Decimal(12, 2)
  changeAmount     Decimal?     @map("change_amount") @db.Decimal(12, 2)
  isCredit         Boolean      @default(false) @map("is_credit")
  paidAmount       Decimal      @default(0) @map("paid_amount") @db.Decimal(12, 2) // solo relevante si isCredit — cuánto se ha pagado de esta venta
  pointsEarned     Int          @default(0) @map("points_earned")
  pointsRedeemed   Int          @default(0) @map("points_redeemed")
  notes            String?
  voidedAt         DateTime?    @map("voided_at")
  voidedById       String?      @map("voided_by_id")
  voidReason       String?      @map("void_reason")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  cashSession           CashSession?           @relation(fields: [cashSessionId], references: [id])
  cashier               User                   @relation("CashierSales", fields: [cashierId], references: [id])
  createdBy             User                   @relation("CreatedBySales", fields: [createdById], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  documentSeries        DocumentSeries?        @relation(fields: [documentSeriesId], references: [id])
  voidedBy              User?                  @relation("VoidedBySales", fields: [voidedById], references: [id])
  items                 SaleItem[]
  payments              SalePayment[]
  returns               SaleReturn[]
  debtPayments          CustomerDebtPayment[]
  promotionApplications PromotionApplication[]
  couponGenerated       Coupon?                @relation("CouponSourceSale")
  couponRedeemed        Coupon?                @relation("CouponRedeemedSale")

  @@index([cashSessionId])
  @@index([cashierId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([documentNumber])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String   @map("sale_id")
  productId       String   @map("product_id")
  quantity        Decimal  @db.Decimal(10, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  originalPrice   Decimal  @map("original_price") @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal  @default(0.18) @map("tax_rate") @db.Decimal(5, 4)
  subtotal        Decimal  @db.Decimal(12, 2)
  // Costo promedio ponderado del producto en el momento exacto de la venta —
  // así el margen de una venta pasada no cambia cuando el costo del producto
  // sigue moviéndose después por nuevas compras.
  costPrice       Decimal? @map("cost_price") @db.Decimal(10, 4)
  productName     String   @map("product_name") // snapshot del nombre al momento de la venta
  productBarcode  String?  @map("product_barcode")

  sale        Sale             @relation(fields: [saleId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String        @map("sale_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // número de operación, voucher
  cardLast4 String?       @map("card_last_4")
  createdAt DateTime      @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("sale_payments")
}

model SaleReturn {
  id           String        @id @default(uuid())
  saleId       String        @map("sale_id")
  reason       String
  totalAmount  Decimal       @map("total_amount") @db.Decimal(12, 2)
  refundMethod PaymentMethod @map("refund_method")
  processedAt  DateTime      @default(now()) @map("processed_at")
  notes        String?

  sale  Sale             @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]

  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @default(uuid())
  returnId     String  @map("return_id")
  saleItemId   String  @map("sale_item_id")
  quantity     Decimal @db.Decimal(10, 3)
  refundAmount Decimal @map("refund_amount") @db.Decimal(10, 2)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@map("sale_return_items")
}

// =============================================================================
// GASTOS
// =============================================================================

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  method      PaymentMethod   @default(CASH)
  reference   String?
  receiptUrl  String?         @map("receipt_url")
  expenseDate DateTime        @default(now()) @map("expense_date")
  templateId  String?         @map("template_id") // si se generó solo desde una plantilla recurrente
  notes       String?
  userId      String          @map("user_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user     User                      @relation(fields: [userId], references: [id])
  template RecurringExpenseTemplate? @relation(fields: [templateId], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

// =============================================================================
// PROMOCIONES
// =============================================================================

model Promotion {
  id          String              @id @default(uuid())
  name        String
  description String?
  type        PromotionType
  value       Decimal             @db.Decimal(10, 2) // porcentaje o monto
  // Solo para HAPPY_HOUR — indica si "value" es % o monto fijo en soles.
  valueType   PromotionValueType? @map("value_type")
  minQuantity Int?                @map("min_quantity")
  maxQuantity Int?                @map("max_quantity")
  minAmount   Decimal?            @map("min_amount") @db.Decimal(10, 2)
  buyQuantity Int?                @map("buy_quantity")
  getQuantity Int?                @map("get_quantity")
  startDate   DateTime            @map("start_date")
  endDate     DateTime?           @map("end_date")
  startTime   String?             @map("start_time") // "14:00"
  endTime     String?             @map("end_time") // "18:00"
  daysOfWeek  Int[]               @map("days_of_week") // 0=Dom, 1=Lun...
  isActive    Boolean             @default(true) @map("is_active")
  priority    Int                 @default(0)
  showInStore Boolean             @default(false) @map("show_in_store")
  storeImage  String?             @map("store_image")
  storeVideo  String?             @map("store_video")
  storeBadge  String?             @map("store_badge")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  products     PromotionProduct[]
  categories   PromotionCategory[]
  applications PromotionApplication[]

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String @map("promotion_id")
  productId   String @map("product_id")
  // Solo tiene sentido para type=COMBO: cuántas unidades de ESTE producto
  // entran en el combo (ej. 2 panes + 1 leche). Para los demás tipos de
  // oferta se ignora (siempre 1).
  quantity    Int    @default(1)

  promotion Promotion @relation(fields: [promotionId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionCategory {
  promotionId String @map("promotion_id")
  categoryId  String @map("category_id")

  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

model PromotionApplication {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  promotionId String   @map("promotion_id")
  discount    Decimal  @db.Decimal(10, 2)
  appliedAt   DateTime @default(now()) @map("applied_at")

  sale      Sale      @relation(fields: [saleId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@index([saleId])
  @@map("promotion_applications")
}

// Un pago de deuda se aplica a UNA venta fiada específica (elegida
// manualmente por el cajero) — así se sabe con certeza cuál venta quedó
// saldada, en vez de solo restar del saldo general del cliente. saleId es
// nullable solo por compatibilidad con pagos históricos previos a este
// campo; la API exige elegir una venta para cualquier pago nuevo.
model CustomerDebtPayment {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  saleId     String?  @map("sale_id")
  amount     Decimal  @db.Decimal(12, 2)
  method     String
  notes      String?
  paidAt     DateTime @default(now()) @map("paid_at")
  // Cuando un cliente paga su cuenta, un solo pago puede aplicarse a varias
  // ventas a la vez — cada aplicación queda como su propia fila (una por
  // venta), pero comparten este id para poder mostrarlas agrupadas como
  // "un pago" en vez de una fila suelta por cada venta. Nullable porque los
  // registros creados antes de este campo no lo tienen (se tratan como su
  // propio grupo de 1).
  groupId    String?  @map("group_id")

  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])

  @@index([customerId])
  @@index([saleId])
  @@index([groupId])
  @@map("customer_debt_payments")
}

// =============================================================================
// TIENDA ONLINE
// =============================================================================

model StoreCustomer {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  // Cada cuenta de la tienda online tiene su ficha espejo en el módulo
  // Clientes del ERP — así las compras online cuentan para el historial,
  // puntos de fidelización, etc. igual que un cliente atendido en tienda.
  // Nullable porque las cuentas creadas antes de este campo no lo tienen.
  customerId   String?  @map("customer_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer  Customer?      @relation(fields: [customerId], references: [id])
  orders    StoreOrder[]
  addresses StoreAddress[]

  @@index([phone])
  @@index([email])
  @@index([customerId])
  @@map("store_customers")
}

model StoreAddress {
  id         String  @id @default(uuid())
  customerId String  @map("customer_id")
  label      String  @default("Casa")
  address    String
  district   String
  reference  String?
  isDefault  Boolean @default(false) @map("is_default")

  customer StoreCustomer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("store_addresses")
}

model StoreOrder {
  id              String         @id @default(uuid())
  orderNumber     String         @unique @map("order_number")
  customerName    String         @map("customer_name")
  customerPhone   String         @map("customer_phone")
  customerEmail   String?        @map("customer_email")
  deliveryType    String         @map("delivery_type") // DELIVERY | PICKUP
  address         String?
  district        String?
  reference       String?
  notes           String?
  status          String         @default("PENDING")
  // PENDING | CONFIRMED | PREPARING | READY | DELIVERED | CANCELLED
  paymentMethod   String         @map("payment_method") // YAPE | PLIN | CASH
  paymentStatus   String         @default("PENDING") @map("payment_status")
  // PENDING | VERIFIED | REJECTED
  paymentProof    String?        @map("payment_proof")
  saleId          String?        @map("sale_id")
  storeCustomerId String?        @map("store_customer_id")
  storeCustomer   StoreCustomer? @relation(fields: [storeCustomerId], references: [id])
  subtotal        Decimal        @db.Decimal(12, 2)
  deliveryCost    Decimal        @default(0) @map("delivery_cost") @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  items StoreOrderItem[]

  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
  @@map("store_orders")
}

model StoreOrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  name      String
  imageUrl  String? @map("image_url")
  quantity  Decimal @db.Decimal(10, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  order StoreOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("store_order_items")
}
